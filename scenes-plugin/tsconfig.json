{
  "extends": "../excalidraw/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": "../excalidraw",
    "paths": {
      "@excalidraw/common": [
        "./packages/common/src/index.ts"
      ],
      "@excalidraw/common/*": [
        "./packages/common/src/*"
      ],
      "@excalidraw/excalidraw": [
        "./packages/excalidraw/index.tsx"
      ],
      "@excalidraw/excalidraw/*": [
        "./packages/excalidraw/*"
      ],
      "@excalidraw/element": [
        "./packages/element/src/index.ts"
      ],
      "@excalidraw/element/*": [
        "./packages/element/src/*"
      ],
      "@excalidraw/fractional-indexing": [
        "./packages/fractional-indexing/src/index.ts"
      ],
      "@excalidraw/fractional-indexing/*": [
        "./packages/fractional-indexing/src/*"
      ],
      "@excalidraw/laser-pointer": [
        "./packages/laser-pointer/src/index.ts"
      ],
      "@excalidraw/laser-pointer/*": [
        "./packages/laser-pointer/src/*"
      ],
      "@excalidraw/math": [
        "./packages/math/src/index.ts"
      ],
      "@excalidraw/math/*": [
        "./packages/math/src/*"
      ],
      "@excalidraw/utils": [
        "./packages/utils/src/index.ts"
      ],
      "@excalidraw/utils/*": [
        "./packages/utils/src/*"
      ]
    },
    "rootDir": ".."
  },
  "include": [
    "src",
    "../excalidraw/excalidraw-app/vite-env.d.ts",
    "../excalidraw/packages/excalidraw/global.d.ts"
  ]
}