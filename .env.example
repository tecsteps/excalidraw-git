# Copy to .env and adjust.
# --- Kurviq (git-backed Excalidraw scenes) ---
# remote repo the scenes server commits & pushes to (uses your local git credentials)
SCENES_GIT_REPO=https://github.com/<owner>/<scenes-repo>
SCENES_GIT_BRANCH=main
SCENES_SERVER_PORT=3101
# where the frontend reaches the scenes server
SCENES_SERVER_URL=http://localhost:3101
# the app's URL (Herd proxy draw.test -> localhost:3001, see README);
# used for the headless renderer and in messages to agents.
# Without Herd: http://localhost:3001 or http://draw.localhost:3001
SCENES_APP_URL=http://draw.test

# How often the scenes server checks GitHub for other people's changes while
# the app is open, in ms (default 60000)
# SCENES_WATCH_INTERVAL_MS=60000
