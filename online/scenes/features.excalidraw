      "link": null,
      "locked": false,
      "customData": {
        "rich": {
          "v": 1,
          "p": [
            {
              "r": [
                {
                  "t": "Click "
                },
                {
                  "t": "MCP",
                  "b": true
                },
                {
                  "t": " (top left) and give the link to your agent: Claude Code, Codex, Cursor, Claude …"
                }
              ]
            },
            {
              "r": []
            },
            {
              "r": [
                {
                  "t": "It reads, draws and edits your scenes"
                }
              ],
              "k": "ul"
            },
            {
              "r": [
                {
                  "t": "You watch its changes arrive; yours are never overwritten"
                }
              ],
              "k": "ul"
            },
            {
              "r": [
                {
                  "t": "It knows what you changed since its last edit"
                }
              ],
              "k": "ul"
            },
            {
              "r": [
                {
                  "t": "It builds whole slide decks and looks at the result"
                }
              ],
              "k": "ul"
            }
          ]
        }
      },
      "text": "Click MCP (top left) and give the link to your \nagent: Claude Code, Codex, Cursor, Claude …\n\n• It reads, draws and edits your scenes\n• You watch its changes arrive; yours are \nnever overwritten\n• It knows what you changed since its last \nedit\n• It builds whole slide decks and looks at \nthe result",
      "fontSize": 34,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Click MCP (top left) and give the link to your agent: Claude Code, Codex, Cursor, Claude …\n\n• It reads, draws and edits your scenes\n• You watch its changes arrive; yours are never overwritten\n• It knows what you changed since its last edit\n• It builds whole slide decks and looks at the result",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
