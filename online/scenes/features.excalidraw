      "seed": 379660670,
      "version": 3,
      "versionNonce": 861669794,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1792663520628,
      "created": 1792663520607,
      "link": null,
      "locked": false,
      "customData": {
        "rich": {
          "v": 1,
          "p": [
            {
              "r": [
                {
                  "t": "Every scene has a link like "
                },
                {
                  "t": "kurviq.com/@you/roadmap",
                  "c": "#6965db"
                },
                {
                  "t": ": "
                },
                {
                  "t": "Copy link",
                  "b": true
                },
                {
                  "t": " in the Scenes sidebar."
                }
              ]
            },
            {
              "r": []
            },
            {
              "r": [
                {
                  "t": "Teammates",
                  "b": true
                },
                {
                  "t": " open it, sign in with GitHub, and see it if they may read the repository"
                }
              ],
              "k": "ul"
            },
            {
              "r": [
                {
                  "t": "Make public:",
                  "b": true
                },
                {
                  "t": " it moves to "
                },
                {
                  "t": "you/kurviq-public",
                  "c": "#6965db"
                },
                {
                  "t": "; everyone can view it, no sign-up"
                }
              ],
              "k": "ul"
            },
            {
              "r": [
                {
                  "t": "Make a copy",
                  "b": true
                },
                {
                  "t": " puts any shared scene into your own scenes"
                }
              ],
              "k": "ul"
            }
          ]
        }
      },
      "text": "Every scene has a link like \nkurviq.com/@you/roadmap: Copy link in the \nScenes sidebar.\n\n• Teammates open it, sign in with GitHub, \nand see it if they may read the repository\n• Make public: it moves to you/kurviq-public; \neveryone can view it, no sign-up\n• Make a copy puts any shared scene into \nyour own scenes",
      "fontSize": 34,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Every scene has a link like kurviq.com/@you/roadmap: Copy link in the Scenes sidebar.\n\n• Teammates open it, sign in with GitHub, and see it if they may read the repository\n• Make public: it moves to you/kurviq-public; everyone can view it, no sign-up\n• Make a copy puts any shared scene into your own scenes",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
