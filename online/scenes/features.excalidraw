      "link": null,
      "locked": false,
      "customData": {
        "rich": {
          "v": 1,
          "p": [
            {
              "r": [
                {
                  "t": "Connect GitHub and your scenes are files in your private repository "
                },
                {
                  "t": "kurviq-scenes",
                  "c": "#6965db"
                },
                {
                  "t": ": Kurviq creates it for you."
                }
              ]
            },
            {
              "r": []
            },
            {
              "r": [
                {
                  "t": "Saved by itself, a few seconds after you stop drawing"
                }
              ],
              "k": "ul"
            },
            {
              "r": [
                {
                  "t": "Changes from your other devices and from teammates are "
                },
                {
                  "t": "merged element by element",
                  "b": true
                }
              ],
              "k": "ul"
            },
            {
              "r": [
                {
                  "t": "Full history in git, commits made by your own account"
                }
              ],
              "k": "ul"
            },
            {
              "r": [
                {
                  "t": "Optional: without GitHub, scenes stay in your browser"
                }
              ],
              "k": "ul"
            }
          ]
        }
      },
      "text": "Connect GitHub and your scenes are files in \nyour private repository kurviq-scenes: Kurviq \ncreates it for you.\n\n• Saved by itself, a few seconds after you \nstop drawing\n• Changes from your other devices and from \nteammates are merged element by element\n• Full history in git, commits made by your \nown account\n• Optional: without GitHub, scenes stay in \nyour browser",
      "fontSize": 34,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Connect GitHub and your scenes are files in your private repository kurviq-scenes: Kurviq creates it for you.\n\n• Saved by itself, a few seconds after you stop drawing\n• Changes from your other devices and from teammates are merged element by element\n• Full history in git, commits made by your own account\n• Optional: without GitHub, scenes stay in your browser",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
